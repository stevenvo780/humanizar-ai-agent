# Una de las dos claves. Con ambas, LLM_PROVIDER decide (anthropic | openai).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-4o-mini
# Con OPENAI_API_KEY se usan embeddings de OpenAI; EMBEDDINGS=tfidf fuerza el índice local.
EMBEDDINGS=openai
# Similitud coseno mínima para considerar relevante un fragmento (vacío = valor por defecto).
MIN_SCORE=
