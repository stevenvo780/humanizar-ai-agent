# Add a NEW key here locally. Never paste credentials into chat or source code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MODE=auto
# Global bound shared by JSON and SSE chat requests. Excess requests receive 429.
MAX_CONCURRENT_CHATS=4
COMPANY_NAME=Humanizar
COMPANY_DESCRIPTION=Software a medida y agentes de IA para ventas, distribución, comercios y operación empresarial.
ASSISTANT_NAME=Humanizar IA
# Optional public company profile. null uses the Humanizar example only
# when COMPANY_NAME is Humanizar; a different company inherits no Humanizar links.
# [] explicitly disables suggestions or products.
COMPANY_WEBSITE=
COMPANY_SUGGESTED_QUESTIONS=null
# JSON array of {"name": "Product", "keywords": ["process"]}; evidence is still required.
COMPANY_PRODUCTS=null
SEED_DEMO=false
# Relative to backend/ locally and /app in Docker. Clear for a different company.
KNOWLEDGE_DIR=knowledge/humanizar
AUTH_ENABLED=true
DATA_DIR=./data
# Empty uses SQLite locally. PostgreSQL production settings stay on the API only.
DATABASE_URL=
DATABASE_SCHEMA=lumen
# Empty preserves the local generated JWT key. Production requires stable secrets.
JWT_SECRET=
AUTH_BOOTSTRAP_TOKEN=
# fastembed: multilingual semantic vectors, prepared by make setup.
# hash: offline lexical fallback without model downloads.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_THREADS=2
# Optional remote Qdrant. Empty uses persistent local mode (one API worker).
QDRANT_URL=
SANDBOX_URL=
MCP_ENABLED=true
