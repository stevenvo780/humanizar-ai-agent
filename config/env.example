# Add a NEW key here locally. Never paste credentials into chat or source code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MODE=auto
# Global bound shared by JSON and SSE chat requests. Excess requests receive 429.
MAX_CONCURRENT_CHATS=4
COMPANY_NAME=Softop
COMPANY_DESCRIPTION=Software de gestión para ópticas: ventas, inventario, agenda, reportes, garantías y caja.
ASSISTANT_NAME=Asistente Softop
# Optional public company profile. Suggested questions: JSON array of strings.
# null uses generic UI prompts and no links; [] disables suggestions or products.
COMPANY_WEBSITE=
COMPANY_SUGGESTED_QUESTIONS=["¿Cómo registro una venta de lentes?","¿Qué hago si el inventario no cuadra?","¿Cómo genero un reporte mensual?","¿Cómo cierro caja al final del día?"]
# JSON array of {"name": "Product", "keywords": ["process"]}; evidence is still required.
# The Softop FAQ names no products, so recommendations stay disabled.
COMPANY_PRODUCTS=[]
SEED_DEMO=false
# Relative to backend/ locally and /app in Docker: one Markdown file per Softop FAQ.
# Use a new DATA_DIR when switching to a different company corpus.
KNOWLEDGE_DIR=knowledge/softop
AUTH_ENABLED=true
DATA_DIR=./data
# Empty uses SQLite locally. PostgreSQL production settings stay on the API only.
DATABASE_URL=
DATABASE_SCHEMA=lumen
# Empty preserves the local generated JWT key. Production requires stable secrets.
JWT_SECRET=
AUTH_BOOTSTRAP_TOKEN=
# fastembed: multilingual semantic vectors, prepared by make setup.
# hash: offline lexical fallback without model downloads.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_THREADS=2
# Optional remote Qdrant. Empty uses persistent local mode (one API worker).
QDRANT_URL=
SANDBOX_URL=
MCP_ENABLED=true
