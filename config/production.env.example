# PUBLIC TEMPLATE ONLY. Copy outside the repository with permissions 0600.
# Literal KEY=value format: no export, shell quoting, interpolation or multiline values.
# Add private values locally; never publish the completed file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MODE=auto
# Empty URL uses SQLite for local development. Production helper requires PostgreSQL.
# Private URL shape: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full&sslrootcert=system
DATABASE_URL=
DATABASE_SCHEMA=lumen
# Required in production: private stable JWT signing secret, at least 32 characters.
# Local development can leave it empty and preserve its generated secret in /data.
JWT_SECRET=
# Required in production: protect first-admin HTTP provisioning, at least 32 characters.
# Create the first admin through the private CLI before publishing the frontend.
# Rotate this token after provisioning; an existing admin already closes bootstrap.
AUTH_BOOTSTRAP_TOKEN=
AUTH_ENABLED=true
# JSON array of exact public frontend origins, without trailing slashes.
CORS_ORIGINS=["https://frontend.example"]
COMPANY_NAME=Softop
COMPANY_DESCRIPTION=Software de gestión para ópticas: ventas, inventario, agenda, reportes, garantías y caja.
ASSISTANT_NAME=Asistente Softop
# Optional profile as JSON arrays: null uses generic prompts, [] disables.
COMPANY_WEBSITE=
COMPANY_SUGGESTED_QUESTIONS=["¿Cómo registro una venta de lentes?","¿Qué hago si el inventario no cuadra?","¿Cómo genero un reporte mensual?","¿Cómo cierro caja al final del día?"]
COMPANY_PRODUCTS=[]
SEED_DEMO=false
# Loads missing files once by name; documents already stored in /data stay until deleted.
KNOWLEDGE_DIR=knowledge/softop
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_THREADS=2
MAX_CONCURRENT_CHATS=4
MCP_ENABLED=true
# DATA_DIR, SANDBOX_URL, QDRANT_URL and LUMEN_API_URL are fixed by production Compose.
# API_ORIGIN and ORIGIN_SECRET belong to Vercel/proxy private configuration, not this file.
