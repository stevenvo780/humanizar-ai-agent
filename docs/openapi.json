  "components": {
    "schemas": {
      "ActionConfirmation": {
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "create_demo_request",
              "create_support_ticket"
            ],
            "title": "Tool"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "action_key": {
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{36}$",
            "title": "Action Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "input",
          "action_key"
        ],
        "title": "ActionConfirmation"
      },
      "Body_upload_api_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 40,
            "title": "History"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[\\w-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/ToolTrace"
            },
            "type": "array",
            "title": "Trace"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "anthropic"
            ],
            "title": "Mode"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources",
          "trace",
          "mode",
          "model",
          "usage",
          "session_id"
        ],
        "title": "ChatResponse"
      },
      "CompanyInfo": {
        "properties": {
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "company_description": {
            "type": "string",
            "title": "Company Description"
          },
          "assistant_name": {
            "type": "string",
            "title": "Assistant Name"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "suggested_questions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Questions"
          }
        },
        "type": "object",
        "required": [
          "company_name",
          "company_description",
          "assistant_name"
        ],
        "title": "CompanyInfo"
      },
      "CustomerCreatedResponse": {
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/PublicCustomer"
          }
        },
        "type": "object",
        "required": [
          "customer"
        ],
        "title": "CustomerCreatedResponse"
      },
      "CustomerListResponse": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/PublicCustomer"
            },
            "type": "array",
            "title": "Customers"
          },
          "total": {
            "type": "integer",
            "title": "Total"
